# Runtime mode: local | preview | production
APP_ENV=local


# Server-side prices. Real checkout requires Razorpay credentials; there is no payment simulator.
PRICE_ACTION_REPORT_PAISE=4900
PRICE_STARTER_PAISE=9900
PRICE_PRO_PAISE=19900

# Generate independent random 32+ byte values. Never commit real values.
ENTITLEMENT_SECRET=replace-with-a-random-secret-at-least-32-characters
SESSION_SECRET=replace-with-a-different-random-secret-at-least-32-characters


# Razorpay Standard Checkout + Subscriptions
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_STARTER_PLAN_ID=
RAZORPAY_PRO_PLAN_ID=


# Comma-separated account emails allowed to open /admin.
# In local mode only, an empty value allows the signed-in development user.
ADMIN_EMAILS=

# Mobile OTP — MSG91 OTP Widget (custom UI)
# MSG91_AUTH_KEY stays server-side and validates the access token returned after OTP verification.
# MSG91_WIDGET_ID and MSG91_WIDGET_TOKEN are delivered to the browser by /api/config/auth-widget.
MSG91_AUTH_KEY=
MSG91_WIDGET_ID=
MSG91_WIDGET_TOKEN=

# Comma-separated E.164-like digits allowed to open /admin through mobile login.
# Example: 919876543210
ADMIN_PHONES=

# AWS S3 blog media (server-only; keep bucket private)
AWS_S3_REGION=ap-south-1
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# F6 official marketplace API connections (server-only; set production values with wrangler secret put)
CONNECTOR_ENCRYPTION_KEY=
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
# Optional fixed OAuth callback origin. Production defaults to https://sellerhisab.com
CONNECTOR_CALLBACK_ORIGIN=
# Optional override. Default is read_orders. Add read_shopify_payments or
# read_shopify_payments_accounts only after Shopify approves that scope for the app.
SHOPIFY_SCOPES=read_orders
AMAZON_SPAPI_APPLICATION_ID=
AMAZON_LWA_CLIENT_ID=
AMAZON_LWA_CLIENT_SECRET=
# Set true only while authorizing an Amazon SP-API app that is still in Draft.
AMAZON_SPAPI_DRAFT=false
FLIPKART_CLIENT_ID=
FLIPKART_CLIENT_SECRET=
