{
  "install:ci": "pnpm install --frozen-lockfile",
  "dev": "vite",
  "build": "vinext build",
  "start": "vinext start",
  "typecheck": "tsc --noEmit",
  "test": "vitest run",
  "test:e2e": "playwright test",
  "fixtures": "node scripts/generate-fixtures.mjs",
  "repo:check": "node scripts/check-repo-hygiene.mjs",
  "prod:check": "node scripts/check-production-source.mjs",
  "preview": "vinext start",
  "deploy": "vinext deploy",
  "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
  "db:generate": "drizzle-kit generate",
  "db:local": "wrangler d1 migrations apply DB --local --config wrangler.jsonc",
  "db:remote": "wrangler d1 migrations apply DB --remote --config wrangler.jsonc",
  "cloudflare:login": "wrangler login",
  "cloudflare:whoami": "wrangler whoami",
  "admin:reset": "powershell -ExecutionPolicy Bypass -File .\\scripts\\reset-production-admin.ps1",
  "seo:indexnow": "node scripts/submit-indexnow.mjs",
  "seo:check": "node scripts/check-seo-source.mjs"
}
