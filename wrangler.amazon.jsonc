{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sellerhisab-amazon-connector",
  "main": "worker/amazon-connector.ts",
  "compatibility_date": "2026-05-22",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": false,
  "no_bundle": false,
  "d1_databases": [
    {
      "binding": "AMAZON_DB",
      "database_name": "sellerhisab-amazon-connector",
      "database_id": "3237f0c1-f008-4e4e-8ccb-297c30896a51",
      "migrations_dir": "drizzle/amazon"
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "invocation_logs": false
    }
  }
}
