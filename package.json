{
  "name": "seller-margin-guard",
  "version": "1.4.0",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "pnpm install --frozen-lockfile",
    "dev": "vite",
    "build": "vinext build",
    "start": "vinext start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "fixtures": "node scripts/generate-fixtures.mjs",
    "repo:check": "node scripts/check-repo-hygiene.mjs",
    "prod:check": "node scripts/check-production-source.mjs",
    "preview": "vinext start",
    "deploy": "vinext deploy",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "node -e \"console.error('Production DDL is ordered forward SQL. drizzle/meta ends at 0008; automatic generation is disabled until a reviewed baseline is adopted. Create a forward SQL migration and run schema:check.'); process.exit(1)\"",
    "db:local": "wrangler d1 migrations apply DB --local --config wrangler.jsonc",
    "db:remote": "wrangler d1 migrations apply DB --remote --config wrangler.jsonc",
    "cloudflare:login": "wrangler login",
    "cloudflare:whoami": "wrangler whoami",
    "admin:reset": "powershell -ExecutionPolicy Bypass -File .\\scripts\\reset-production-admin.ps1",
    "seo:indexnow": "node scripts/submit-indexnow.mjs",
    "seo:check": "node scripts/check-seo-source.mjs",
    "schema:check": "node scripts/verify-schema.mjs",
    "compat:check": "vinext check",
    "security:check": "node scripts/check-dependency-security.mjs"
  },
  "dependencies": {
    "@types/papaparse": "^5.5.2",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "decimal.js": "^10.6.0",
    "dexie": "^4.4.5",
    "drizzle-orm": "0.45.2",
    "input-otp": "^1.4.2",
    "jspdf": "^4.2.1",
    "jszip": "^3.10.1",
    "lucide-react": "^1.31.0",
    "next": "^16.3.3",
    "next-themes": "^0.4.6",
    "papaparse": "^5.7.0",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sonner": "^2.0.8",
    "tailwind-merge": "3.6.0",
    "web-vitals": "^6.2.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "^4.20260702.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.34",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "^16.3.3",
    "fast-check": "^4.9.0",
    "react-server-dom-webpack": "19.2.8",
    "tailwindcss": "4.2.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.16",
    "vitest": "^4.1.11",
    "wrangler": "4.92.0"
  },
  "type": "module",
  "displayName": "SellerHisab"
}
